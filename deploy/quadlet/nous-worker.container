[Unit]
Description=Nous Worker
Requires=nous-db.service
After=nous-db.service

[Container]
Image=sha256:0fd26be18258c10968d6d133f3e2f3df8c7d2a91d1b3a3774e5a2ebfbab8223b
ContainerName=nous-worker
Network=nous.network
Secret=nous-runtime-database-url,type=mount,target=/run/secrets/database_url
Environment=DATABASE_URL_FILE=/run/secrets/database_url
Exec=python -m nous.runtime worker
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target

[Unit]
Description=Nous OSINT read-only MCP origin
Requires=nous-db.service
After=nous-db.service

[Container]
Image=localhost/nous-osint@sha256:5c9417f21cc913a3f0b73bfba184599324725e0acee06fc82379b750e2528495
ContainerName=nous-mcp
Network=nous.network
Network=nous-ingress.network
Secret=nous-mcp-database-url,type=mount,target=/run/secrets/database_url
# Separate limited write credential for Access-subject-allowlisted administration.
Secret=nous-admin-database-url,type=mount,target=/run/secrets/admin_database_url
Environment=NOUS_ADMIN_DATABASE_URL_FILE=/run/secrets/admin_database_url
Environment=DATABASE_URL_FILE=/run/secrets/database_url
Environment=NOUS_REPORT_SITE_DIR=/var/lib/nous-reports/site
EnvironmentFile=%h/.config/nous/mcp.env
Volume=nous-report-site.volume:/var/lib/nous-reports/site:ro
Environment=PYTHONDONTWRITEBYTECODE=1
Exec=uvicorn nous.remote_gateway:app --host 0.0.0.0 --port 8001 --workers 1
ReadOnly=true
Tmpfs=/tmp:rw,nosuid,nodev,noexec,size=16m
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=120

[Install]
WantedBy=default.target

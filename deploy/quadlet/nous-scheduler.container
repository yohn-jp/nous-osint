[Unit]
Description=Nous Scheduler
Requires=nous-db.service
After=nous-db.service

[Container]
Image=sha256:f45db6786f92ebb8c44dadc6ff2d88cf40bebfa54382c644615f654e96e2cb4c
ContainerName=nous-scheduler
Network=nous.network
Secret=nous-runtime-database-url,type=mount,target=/run/secrets/database_url
Environment=DATABASE_URL_FILE=/run/secrets/database_url
Exec=python -m nous.runtime scheduler
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target

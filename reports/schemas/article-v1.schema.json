{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nous.yohn.jp/reports/schemas/article-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "language", "title", "dek", "summary", "sections", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "template_id": {"enum": ["security-daily", "cve-kev-deep-dive"]},
    "language": {"const": "ja"},
    "title": {"type": "string", "minLength": 8, "maxLength": 120, "description": "Must exactly match a verified claim's text; enforced by the publication gate."},
    "dek": {"type": "string", "minLength": 10, "maxLength": 240, "description": "Must exactly match a verified claim's text; enforced by the publication gate."},
    "summary": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 12, "maxLength": 240, "description": "Must exactly match a verified claim's text; enforced by the publication gate."}},
    "sections": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/section"}},
    "claims": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/claim"}},
    "cve": {"$ref": "#/$defs/cve"},
    "sources": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "evidenceIds": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "pattern": "^E[0-9]{3}$"}},
    "section": {
      "type": "object", "additionalProperties": false, "required": ["heading", "blocks"],
      "properties": {
        "heading": {"type": "string", "minLength": 2, "maxLength": 80},
        "blocks": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["type", "text", "evidence_ids", "claim_ids"], "properties": {"type": {"const": "paragraph"}, "text": {"type": "string", "minLength": 20, "maxLength": 1600}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}, "claim_ids": {"$ref": "#/$defs/claimIds"}}},
          {"type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": {"type": {"const": "bullet_list"}, "items": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["text", "evidence_ids", "claim_ids"], "properties": {"text": {"type": "string", "minLength": 8, "maxLength": 500}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}, "claim_ids": {"$ref": "#/$defs/claimIds"}}}}}},
          {"type": "object", "additionalProperties": false, "required": ["type", "headers", "rows"], "properties": {"type": {"const": "fact_table"}, "headers": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string", "maxLength": 60}}, "rows": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["cells", "evidence_ids", "claim_ids"], "properties": {"cells": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string", "maxLength": 240}}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}, "claim_ids": {"$ref": "#/$defs/claimIds"}}}}}},
          {"type": "object", "additionalProperties": false, "required": ["type", "evidence_ids"], "properties": {"type": {"const": "source_list"}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}},
          {"type": "object", "additionalProperties": false, "required": ["type", "text", "evidence_ids", "claim_ids"], "properties": {"type": {"const": "quote"}, "text": {"type": "string", "minLength": 4, "maxLength": 300}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}, "claim_ids": {"$ref": "#/$defs/claimIds"}}}
        ]}}
      }
    },
    "claimIds": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{3}$"}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["claim_id", "text", "classification", "evidence_ids"], "properties": {"claim_id": {"type": "string", "pattern": "^C[0-9]{3}$"}, "text": {"type": "string", "minLength": 10, "maxLength": 500}, "classification": {"enum": ["observed", "inference", "unconfirmed"]}, "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "pattern": "^E[0-9]{3}$"}}}},
    "cve": {"type": "object", "additionalProperties": false, "required": ["id", "kev_status", "catalog_as_of", "catalog_fresh", "canonical_url", "catalog_source_url", "evidence_ids"], "properties": {"id": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"}, "kev_status": {"enum": ["listed", "not_listed", "unknown"]}, "catalog_as_of": {"type": ["string", "null"]}, "catalog_fresh": {"type": "boolean"}, "canonical_url": {"type": "string", "format": "uri"}, "catalog_source_url": {"type": ["string", "null"], "format": "uri"}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "source_key", "relation", "title", "publisher_url", "observed_at", "published_at", "license_id"], "properties": {"evidence_id": {"type": "string", "pattern": "^E[0-9]{3}$"}, "source_key": {"type": "string", "maxLength": 100}, "relation": {"enum": ["record", "reference", "kev", "title_mention"]}, "title": {"type": "string", "maxLength": 300}, "publisher_url": {"type": "string", "format": "uri"}, "observed_at": {"type": "string", "format": "date-time"}, "published_at": {"type": ["string", "null"], "format": "date-time"}, "license_id": {"type": "string", "maxLength": 100}}}
  }
}

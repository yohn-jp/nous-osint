{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["claims", "revision_request", "summary"],
  "properties": {
    "claims": {"type": "array", "maxItems": 50, "items": {"type": "object", "additionalProperties": false, "required": ["claim_id", "text", "classification", "evidence_ids", "assessment"], "properties": {"claim_id": {"type": "string", "pattern": "^C[0-9]{3}$"}, "text": {"type": "string", "minLength": 5, "maxLength": 500}, "classification": {"enum": ["observed", "inference", "unconfirmed"]}, "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "pattern": "^E[0-9]{3}$"}}, "assessment": {"enum": ["supported", "interpretation", "unverified", "reject"]}}}},
    "revision_request": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 240}},
    "summary": {"type": "string", "minLength": 5, "maxLength": 500}
  }
}

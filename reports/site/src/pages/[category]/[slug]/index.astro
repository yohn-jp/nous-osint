---
import { getCollection } from 'astro:content';
import ArticleBlock from '../../../components/ArticleBlock.astro';
import ClaimClassifications from '../../../components/ClaimClassifications.astro';
import EvidenceMarks from '../../../components/EvidenceMarks.astro';
import KevPanel from '../../../components/KevPanel.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('reports');
  return entries.map(({ data }) => ({
    params: { category: data.category, slug: data.slug },
    props: { report: data },
  }));
}

const { report } = Astro.props;
const base = import.meta.env.BASE_URL;
const categoryName = report.category === 'cve' ? 'CVE / KEV 調査' : 'セキュリティ分析';
const claimCounts = {
  observed: report.claims.filter((claim) => claim.classification === 'observed').length,
  inference: report.claims.filter((claim) => claim.classification === 'inference').length,
  unconfirmed: report.claims.filter((claim) => claim.classification === 'unconfirmed').length,
};
function dateLabel(value: string) {
  return new Intl.DateTimeFormat('ja-JP', { dateStyle: 'long', timeZone: 'Asia/Tokyo' }).format(new Date(value));
}
function shortDateLabel(value: string | null) {
  return value ? new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Tokyo' }).format(new Date(value)) : '記録なし';
}
function relationName(value: string) {
  return value === 'kev' ? 'KEV掲載根拠' : value === 'title_mention' ? 'タイトル中の言及' : value === 'reference' ? '参照資料' : '収集レコード';
}
function summaryTarget(text: string) {
  const claim = report.claims.find((claim) => report.schema_version === 1
    ? claim.text.trim() === text.trim()
    : claim.text === text);
  if (!claim) return undefined;
  if (report.schema_version === 2) return '#claim-' + claim.claim_id;

  // Legacy articles render claims in typed blocks rather than individual claim anchors.
  const index = report.sections.findIndex(section => section.blocks.some(block => {
    if (block.type === 'bullet_list') return block.items.some(item => item.claim_ids.includes(claim.claim_id));
    if (block.type === 'fact_table') return block.rows.some(row => row.claim_ids.includes(claim.claim_id));
    if (block.type === 'source_list') return false;
    return block.claim_ids.includes(claim.claim_id);
  }));
  return index >= 0 ? '#section-' + index : undefined;
}
---

<BaseLayout title={report.title} description={report.dek}>
  <article class="report-article">
    <nav class="report-breadcrumbs" aria-label="パンくずリスト">
      <a href="/explore">調査ワークスペース</a><span aria-hidden="true">/</span>
      <a href={base}>レポート一覧</a><span aria-hidden="true">/</span>
      <span aria-current="page">{categoryName}</span>
    </nav>

    <header class="report-opening">
      <div class="report-opening-meta">
        <span class="report-category">{categoryName}</span>
        <span>{report.template_id === 'cve-kev-deep-dive' ? 'CVE / KEV 調査' : '公開情報の調査'}</span>
        <time datetime={report.published_at}>公開 {dateLabel(report.published_at)}</time>
      </div>
      <h1 id="report-title">{report.title}</h1>
      <p class="report-dek">{report.dek}</p>
      {report.cve && <p class="report-cve-tag"><span>対象識別子</span><a href={report.cve.canonical_url} rel="noopener noreferrer">{report.cve.id}</a></p>}

      <dl class="report-classification-register" aria-label="本文中の記述分類">
        <div class="classification-total"><dt>主張</dt><dd>{report.claims.length}</dd></div>
        <div class="classification-total"><dt>出典</dt><dd>{report.sources.length}</dd></div>
        <div class="classification-unit"><dt><i class="observed" aria-hidden="true"></i>観測事実</dt><dd>{claimCounts.observed}</dd></div>
        <div class="classification-unit"><dt><i class="inference" aria-hidden="true"></i>分析・推論</dt><dd>{claimCounts.inference}</dd></div>
        <div class="classification-unit"><dt><i class="unconfirmed" aria-hidden="true"></i>未確認</dt><dd>{claimCounts.unconfirmed}</dd></div>
      </dl>
      <p class="report-classification-caveat">分類は各記述の性質を示します。確度や脆弱性の深刻度を示すスコアではありません。</p>
    </header>

    {report.cve && <section class="report-kev-context" aria-label="CISA KEVカタログの状態">
      <KevPanel cve={report.cve} sources={report.sources} />
    </section>}

    <section class="report-brief" aria-labelledby="brief-heading">
      <div class="report-brief-heading">
        <span class="report-section-index">READ FIRST</span>
        <h2 id="brief-heading">先に押さえる要点</h2>
      </div>
      <ol>
        {report.summary.map((line) => {
          const target = summaryTarget(line);
          return <li>
            <p>{line}</p>
            {target && <a class="brief-citation" href={target} aria-label="本文中の該当箇所へ移動">本文へ <span aria-hidden="true">↓</span></a>}
          </li>;
        })}
      </ol>
    </section>

    <div class="report-reading-layout">
      <nav class="report-contents" aria-label="記事の目次">
        <span class="report-contents-label">CONTENTS</span>
        <ol>
          {report.sections.map((section, index) => (
            <li><a href={'#section-' + index}><span>{String(index + 1).padStart(2, '0')}</span>{section.heading}</a></li>
          ))}
        </ol>
        <a class="contents-source-link" href="#sources-heading">資料台帳 <span aria-hidden="true">↘</span></a>
      </nav>

      <div class="report-prose">
        {report.sections.map((section, index) => (
          <section class="report-section" aria-labelledby={'section-' + index}>
            <header class="report-section-heading">
              <span class="report-section-index">{String(index + 1).padStart(2, '0')}</span>
              <h2 id={'section-' + index}>{section.heading}</h2>
            </header>
            {report.schema_version === 1 ? section.blocks.map((block) => (
              <ArticleBlock block={block} sources={report.sources} claims={report.claims} cve={report.cve} />
            )) : section.claim_ids.map((claimId) => {
              const claim = report.claims.find((item) => item.claim_id === claimId);
              return claim && <p class="report-claim" id={'claim-' + claim.claim_id}>
                <span class="claim-text">{claim.text}</span>
                <span class="claim-annotation">
                  <ClaimClassifications claimIds={[claim.claim_id]} claims={report.claims} />
                  <EvidenceMarks evidenceIds={claim.evidence_ids} />
                </span>
              </p>;
            })}
          </section>
        ))}
      </div>
    </div>

    <section class="report-source-register" aria-labelledby="sources-heading">
      <header class="report-source-heading">
        <div><span class="report-contents-label">EVIDENCE REGISTER</span><h2 id="sources-heading">資料台帳</h2></div>
        <p>本文の引用番号から、この資料と観測記録へ移動できます。公開元と保存時点を確認できます。</p>
      </header>
      <ol class="report-source-list">
        {report.sources.map((source) => (
          <li id={'source-' + source.evidence_id}>
            <span class="report-source-evidence">{source.evidence_id}</span>
            <div class="report-source-main">
              <a class="report-source-title" href={source.publisher_url} target="_blank" rel="noopener noreferrer">
                {source.title || source.source_key}<span class="source-external-mark" aria-hidden="true">↗</span>
              </a>
              <span class="report-source-key">{source.source_key} · {relationName(source.relation)}</span>
            </div>
            <div class="report-source-dates">
              <span>観測 <time datetime={source.observed_at}>{shortDateLabel(source.observed_at)}</time></span>
              <span>発行 {source.published_at ? <time datetime={source.published_at}>{shortDateLabel(source.published_at)}</time> : '記録なし'}</span>
              <span>ライセンス {source.license_id || '記録なし'}</span>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <footer class="report-footer">
      <p>この文書は保存された資料の観測時点に基づきます。公開元の掲載状況や内容は、その後変わることがあります。</p>
      <nav aria-label="記事から移動">
        <a href={base}>レポート一覧へ戻る <span aria-hidden="true">←</span></a>
        <a class="report-footer-primary" href="/explore">収集記録を調べる <span aria-hidden="true">↗</span></a>
      </nav>
    </footer>
  </article>
</BaseLayout>

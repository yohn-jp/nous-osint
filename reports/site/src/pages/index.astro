---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('reports');
const reports = entries.map(({ data }) => data).sort(
  (left, right) => new Date(right.published_at).getTime() - new Date(left.published_at).getTime(),
);
const categoryName = (category: string) => category === 'cve' ? 'CVE / KEV' : 'セキュリティ動向';
const kevLabel = (status: string) => ({
  listed: 'KEV掲載あり',
  not_listed: 'KEV掲載なし',
  unknown: 'KEV未確認',
}[status] ?? 'KEV未確認');
function dateLabel(value: string) {
  return new Intl.DateTimeFormat('ja-JP', {
    year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Tokyo',
  }).format(new Date(value));
}
---

<BaseLayout title="インテリジェンスレポート">
  <header class="publication-header">
    <div class="publication-identity"><span>NOUS</span><span aria-hidden="true">/</span><span>PUBLICATIONS</span></div>
    <div class="publication-title-row">
      <div>
        <h1>分析レポート</h1>
        <p>観測情報を検証し、事実と分析を分けて記録した資料です。</p>
      </div>
      <div class="publication-metric" aria-label={'公開記事 ' + reports.length + ' 件'}>
        <strong>{String(reports.length).padStart(2, '0')}</strong><span>公開記事</span>
      </div>
    </div>
  </header>

  <section class="publication-register" aria-labelledby="register-heading">
    <div class="publication-register-bar">
      <div>
        <span class="publication-register-label">DOCUMENT REGISTER</span>
        <h2 id="register-heading">記事一覧</h2>
      </div>
    </div>
    {reports.length > 0 ? (
      <>
        <div class="publication-count" role="status" aria-live="polite">
          <span>{reports.length} 件を表示</span>
          <span>公開日の新しい順</span>
        </div>
        <div class="publication-list">
          {reports.map((report, index) => {
            const facts = report.claims.filter(claim => claim.classification === 'observed').length;
            const assessments = report.claims.filter(claim => claim.classification === 'inference').length;
            const unconfirmed = report.claims.filter(claim => claim.classification === 'unconfirmed').length;
            return (
              <article class="publication-entry">
                <div class="publication-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
                <div class="publication-document">
                  <div class="publication-entry-meta">
                    <span class="publication-type">{categoryName(report.category)}</span>
                    <time datetime={report.published_at}>{dateLabel(report.published_at)}</time>
                    {report.cve && <span class="publication-cve-id">{report.cve.id}</span>}
                  </div>
                  <h3><a href={report.url}>{report.title}</a></h3>
                  <p class="publication-dek">{report.dek}</p>
                  {report.cve && (
                    <div class="publication-kev" data-kev={report.cve.kev_status}>
                      {kevLabel(report.cve.kev_status)}
                      {!report.cve.catalog_fresh && <span>（カタログ鮮度未確認）</span>}
                    </div>
                  )}
                </div>
                <div class="publication-evidence" aria-label="掲載内容の内訳">
                  <span>根拠 <strong>{report.sources.length}</strong> 件</span>
                  <span>観測事実 <strong>{facts}</strong></span>
                  {assessments > 0 && <span>分析 <strong>{assessments}</strong></span>}
                  {unconfirmed > 0 && <span>未確認 <strong>{unconfirmed}</strong></span>}
                  <a href={report.url} class="publication-open">記事を読む <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            );
          })}
        </div>
      </>
    ) : (
      <div class="publication-empty">
        <h3>公開された記事はありません</h3>
        <p>この時点で公開済みの資料はありません。収集されたレコードは探索画面から確認できます。</p>
        <a href="/explore">収集情報を探索する <span aria-hidden="true">↗</span></a>
      </div>
    )}
  </section>
</BaseLayout>


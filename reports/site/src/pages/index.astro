---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('reports');
const reports = entries.map(({ data }) => data).sort(
  (left, right) => new Date(right.published_at).getTime() - new Date(left.published_at).getTime(),
);
const categoryName = (category: string) => category === 'cve' ? 'CVE / KEV' : 'セキュリティ分析';
const kevLabel = (status: string) => ({
  listed: 'KEV掲載を確認',
  not_listed: 'KEV掲載なし',
  unknown: 'KEV状態は未確認',
}[status] ?? 'KEV状態は未確認');
function dateLabel(value: string) {
  return new Intl.DateTimeFormat('ja-JP', {
    year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Tokyo',
  }).format(new Date(value));
}
---

<BaseLayout title="インテリジェンスレポート">
  <header class="archive-heading">
    <div class="archive-heading-copy">
      <p class="publication-kicker"><span aria-hidden="true"></span> NOUS / RESEARCH PUBLICATIONS</p>
      <h1>分析レポート</h1>
      <p>観測された公開情報から、根拠をたどれる形でまとめた調査記録。</p>
    </div>
    <a class="archive-research-link" href="/explore">収集記録を調べる <span aria-hidden="true">↗</span></a>
  </header>

  <section class="publication-register" aria-labelledby="archive-list-heading">
    <div class="archive-list-heading">
      <div><span class="archive-eyebrow">PUBLISHED DOCUMENTS</span><h2 id="archive-list-heading">公開済みの資料</h2></div>
      <span class="archive-count">{reports.length} 件 · 公開日の新しい順</span>
    </div>
    {reports.length > 0 ? (
      <ol class="publication-list">
        {reports.map((report) => {
          const observed = report.claims.filter(claim => claim.classification === 'observed').length;
          const inference = report.claims.filter(claim => claim.classification === 'inference').length;
          const unconfirmed = report.claims.filter(claim => claim.classification === 'unconfirmed').length;
          return (
            <li class="publication-entry">
              <div class="publication-entry-date">
                <time datetime={report.published_at}>{dateLabel(report.published_at)}</time>
                <span>{categoryName(report.category)}</span>
              </div>
              <article class="publication-entry-body">
                <div class="publication-entry-meta">
                  {report.template_id === 'cve-kev-deep-dive' && <span>CVE / KEV 調査</span>}
                  {report.cve && <span class="publication-cve-id">{report.cve.id}</span>}
                </div>
                <h3><a href={report.url}>{report.title}</a></h3>
                <p class="publication-dek">{report.dek}</p>
                {report.cve && (
                  <p class="publication-kev" data-kev={report.cve.kev_status}>
                    <span>{kevLabel(report.cve.kev_status)}</span>
                    <span>カタログ確認日 {report.cve.catalog_as_of ? dateLabel(report.cve.catalog_as_of) : '未確認'}</span>
                    {!report.cve.catalog_fresh && <span>鮮度未確認</span>}
                  </p>
                )}
              </article>
              <div class="publication-entry-register" aria-label="この記事に含まれる主張と出典">
                <span>主張 <strong>{report.claims.length}</strong></span>
                <span>出典 <strong>{report.sources.length}</strong></span>
                <span class="claim-register-count"><i class="observed" aria-hidden="true"></i>観測 {observed}</span>
                {inference > 0 && <span class="claim-register-count"><i class="inference" aria-hidden="true"></i>推論 {inference}</span>}
                {unconfirmed > 0 && <span class="claim-register-count"><i class="unconfirmed" aria-hidden="true"></i>未確認 {unconfirmed}</span>}
                <a href={report.url}>記事を読む <span aria-hidden="true">→</span></a>
              </div>
            </li>
          );
        })}
      </ol>
    ) : (
      <div class="archive-empty">
        <span class="archive-eyebrow">NO PUBLISHED REPORTS</span>
        <h3>まだ公開されたレポートはありません</h3>
        <p>根拠がそろった資料が公開されると、ここに追加されます。収集済みの記録は探索画面から確認できます。</p>
        <a href="/explore">収集記録を調べる <span aria-hidden="true">↗</span></a>
      </div>
    )}
  </section>
</BaseLayout>

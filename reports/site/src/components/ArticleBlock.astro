---
import EvidenceMarks from './EvidenceMarks.astro';
import SourceList from './SourceList.astro';
import ClaimClassifications from './ClaimClassifications.astro';

interface Props {
  block: any;
  sources: any[];
  claims: any[];
  cve?: any;
}

const { block, sources, claims, cve } = Astro.props;
const cveFactClaims = block.type === 'cve_fact'
  ? block.claim_ids.map((id: string) => claims.find((claim: any) => claim.claim_id === id))
    .filter((claim: any) => claim !== undefined)
  : [];
---

{block.type === 'paragraph' && (
  <p class="article-paragraph">
    {block.text}
    <ClaimClassifications claimIds={block.claim_ids} claims={claims} />
    <EvidenceMarks evidenceIds={block.evidence_ids} />
  </p>
)}

{block.type === 'bullet_list' && (
  <ul class="article-list">
    {block.items.map((item: any) => (
      <li>
        {item.text}
        <ClaimClassifications claimIds={item.claim_ids} claims={claims} />
        <EvidenceMarks evidenceIds={item.evidence_ids} />
      </li>
    ))}
  </ul>
)}

{block.type === 'fact_table' && (
  <div class="table-wrap" role="region" aria-label="根拠付きの事実表" tabindex="0">
    <table>
      <thead><tr>{block.headers.map((header: string) => <th scope="col">{header}</th>)}</tr></thead>
      <tbody>
        {block.rows.map((row: any) => (
          <tr>
            {row.cells.map((cell: string, index: number) => (
              <td>{cell}{index === row.cells.length - 1 && <>
                <ClaimClassifications claimIds={row.claim_ids} claims={claims} />
                <EvidenceMarks evidenceIds={row.evidence_ids} />
              </>}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

{block.type === 'source_list' && <SourceList evidenceIds={block.evidence_ids} sources={sources} />}

{block.type === 'cve_fact' && cve?.id === block.cve_id && (
  <section class="cve-fact-block" aria-label="CVEの根拠と確認済みの記述">
    <header class="cve-fact-heading">
      <p class="eyebrow">CVE FACT</p>
      <h3>対象CVE: <a href={cve.canonical_url} rel="noopener noreferrer">{block.cve_id}</a></h3>
    </header>
    <ul class="cve-fact-claims">
      {cveFactClaims.map((claim: any) => (
        <li>
          {claim.text}
          <ClaimClassifications claimIds={[claim.claim_id]} claims={claims} />
          <EvidenceMarks evidenceIds={claim.evidence_ids} />
        </li>
      ))}
    </ul>
    <p class="cve-fact-evidence">このCVE記述に関連する出典 <EvidenceMarks evidenceIds={block.evidence_ids} /></p>
  </section>
)}

{block.type === 'quote' && (
  <figure class="source-quote">
    <blockquote>{block.text}</blockquote>
    <figcaption>
      <ClaimClassifications claimIds={block.claim_ids} claims={claims} />
      <EvidenceMarks evidenceIds={block.evidence_ids} />
    </figcaption>
  </figure>
)}

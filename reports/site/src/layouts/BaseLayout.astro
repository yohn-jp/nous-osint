---
import '../styles/global.css';
import '../styles/workstation.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Nous OSINT が保存した公開情報と根拠から構成した分析レポートです。' } = Astro.props;
const base = import.meta.env.BASE_URL;
const origin = Astro.site ?? new URL('https://nous.yohn.jp');
const sourcesUrl = new URL('/sources', origin).toString();
const changesUrl = new URL('/changes', origin).toString();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title} | Nous OSINT</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/explore" aria-label="Nous OSINT の探索画面へ">
          <span class="brand-mark" aria-hidden="true">N</span>
          <span class="brand-wordmark">nous<span class="brand-product"> / osint</span></span>
        </a>
        <span class="header-context" aria-hidden="true">INTELLIGENCE WORKSPACE</span>
        <span class="site-context-tag">REPORT LIBRARY</span>
      </div>
    </header>
    <div class="site-workspace">
      <aside class="site-rail" aria-label="ワークスペースの移動">
        <nav class="site-rail-nav" aria-label="Nous OSINT の主要画面">
          <span class="rail-caption">RESEARCH</span>
          <a class="workspace-link" href="/explore">探索</a>
          <a class="workspace-link" href={changesUrl} rel="noopener noreferrer">変更履歴</a>
          <a class="workspace-link" href={sourcesUrl} rel="noopener noreferrer">情報源</a>
          <span class="rail-caption rail-caption-secondary">PUBLICATIONS</span>
          <a class="workspace-link workspace-link-active" href={base} aria-current="page">分析レポート</a>
        </nav>
        <div class="site-rail-footer">NOUS / RESEARCH INSTRUMENT</div>
      </aside>
      <div class="site-workspace-body">
        <main id="main-content" class="site-main">
          <slot />
        </main>
        <footer class="site-footer">
          <div class="footer-inner">
            <div class="footer-identity">
              <span class="footer-brand">nous / osint</span>
              <span>出典を追跡できる分析</span>
            </div>
            <nav class="footer-nav" aria-label="他の画面へ移動">
              <a href="/explore">探索</a>
              <a href={changesUrl} rel="noopener noreferrer">変更履歴</a>
              <a href={sourcesUrl} rel="noopener noreferrer">情報源</a>
              <a href={base}>レポート一覧</a>
            </nav>
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>

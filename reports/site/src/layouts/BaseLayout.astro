---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Nous OSINT が保存した公開情報と根拠から構成した分析レポートです。' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title} | Nous OSINT Reports</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={base} aria-label="Nous OSINT レポート一覧">
          <span class="brand-mark" aria-hidden="true">N</span>
          <span>nous<span class="brand-separator"> / </span>osint</span>
        </a>
        <nav aria-label="メインナビゲーション">
          <a href={base} class="reports-home">レポート一覧</a>
          <a href="/explore" class="library-return"><span aria-hidden="true">←</span> ダッシュボードへ戻る</a>
        </nav>
      </div>
    </header>
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>Nous OSINT · Sources first</span>
        <nav class="footer-nav" aria-label="閲覧先">
          <a href={base}>レポート一覧</a>
          <a href="/explore">ダッシュボードへ戻る <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </footer>
  </body>
</html>

  "claims": [
    {
      "claim_id": "C001",
      "text": "検証用の合成情報源は注意喚起の改訂を公開しています。",
      "classification": "observed",
      "evidence_ids": [
        "E001"
      ],
      "section": "primary_observations",
      "importance": "high"
    },
    {
      "claim_id": "C002",
      "text": "合成資料の更新日時は検証用データに記録されています。",
      "classification": "observed",
      "evidence_ids": [
        "E002"
      ],
      "section": "primary_observations",
      "importance": "normal"
    },
    {
      "claim_id": "C003",
      "text": "合成アドバイザリは影響する製品群を列挙しています。",
      "classification": "observed",
      "evidence_ids": [
        "E003",
        "E004"
      ],
      "section": "primary_observations",
      "importance": "high"
    },
    {
      "claim_id": "C004",
      "text": "検証用の変更履歴には修正済みバージョンが記載されています。",
      "classification": "observed",
      "evidence_ids": [
        "E004"
      ],
      "section": "primary_observations",
      "importance": "normal"
    },
    {
      "claim_id": "C005",
      "text": "合成資料は緩和策として設定変更を案内しています。",
      "classification": "observed",
      "evidence_ids": [
        "E005"
      ],
      "section": "primary_observations",
      "importance": "normal"
    },
    {
      "claim_id": "C006",
      "text": "検証用の参考文書には調査対象の識別子が記載されています。",
      "classification": "observed",
      "evidence_ids": [
        "E006"
      ],
      "section": "primary_observations",
      "importance": "normal"
    },
    {
      "claim_id": "C007",
      "text": "合成情報源の公開元は追加の技術資料へリンクしています。",
      "classification": "observed",
      "evidence_ids": [
        "E007"
      ],
      "section": "primary_observations",
      "importance": "normal"
    },
    {
      "claim_id": "C008",
      "text": "検証用の記録では更新前後の説明が保存されています。",
      "classification": "observed",
      "evidence_ids": [
        "E008"
      ],
      "section": "primary_observations",
      "importance": "normal"
    },
    {
      "claim_id": "C009",
      "text": "複数の合成資料は共通する製品群に言及しています。",
      "classification": "inference",
      "evidence_ids": [
        "E009",
        "E010"
      ],
      "section": "analysis",
      "importance": "high"
    },
    {
      "claim_id": "C010",
      "text": "合成資料間の時刻差だけでは公開順序を確定できません。",
      "classification": "inference",
      "evidence_ids": [
        "E010"
      ],
      "section": "analysis",
      "importance": "normal"
    },
    {
      "claim_id": "C011",
      "text": "記載された緩和策は製品ごとの適用条件が異なります。",
      "classification": "inference",
      "evidence_ids": [
        "E011"
      ],
      "section": "analysis",
      "importance": "normal"
    },
    {
      "claim_id": "C012",
      "text": "更新履歴の一致は同一の原因を示すとは限りません。",
      "classification": "inference",
      "evidence_ids": [
        "E012"
      ],
      "section": "analysis",
      "importance": "normal"
    },
    {
      "claim_id": "C013",
      "text": "参照先の構成差が影響範囲の解釈に影響する可能性があります。",
      "classification": "inference",
      "evidence_ids": [
        "E013",
        "E014"
      ],
      "section": "analysis",
      "importance": "normal"
    },
    {
      "claim_id": "C014",
      "text": "利用可能な合成資料だけでは悪用の有無を判断できません。",
      "classification": "inference",
      "evidence_ids": [
        "E014"
      ],
      "section": "analysis",
      "importance": "normal"
    },
    {
      "claim_id": "C015",
      "text": "一部の検証用資料では対象バージョンが明示されていません。",
      "classification": "unconfirmed",
      "evidence_ids": [
        "E015"
      ],
      "section": "unknowns",
      "importance": "normal"
    },
    {
      "claim_id": "C016",
      "text": "合成情報源の一つは関連する修正版を特定していません。",
      "classification": "unconfirmed",
      "evidence_ids": [
        "E016"
      ],
      "section": "unknowns",
      "importance": "normal"
    },
    {
      "claim_id": "C017",
      "text": "検証用の記録には実環境での適用結果が含まれていません。",
      "classification": "unconfirmed",
      "evidence_ids": [
        "E017"
      ],
      "section": "unknowns",
      "importance": "normal"
    },
    {
      "claim_id": "C018",
      "text": "追加の公開情報がないため影響組織の範囲は未確認です。",
      "classification": "unconfirmed",
      "evidence_ids": [
        "E018"
      ],
      "section": "unknowns",
      "importance": "normal"
    }
